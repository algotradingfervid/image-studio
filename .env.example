# RunPod credentials for the image studio backend.
# Copy to .env and fill in. Never commit .env.

# RunPod API key: https://www.runpod.io/console/user/settings -> API Keys
RUNPOD_API_KEY=

# Serverless endpoint ID (filled in once the ComfyUI endpoint is created)
RUNPOD_ENDPOINT_ID=

# Civitai API key (for downloading LoRAs from civitai.com): https://civitai.com/user/account -> API Keys
CIVITAI_API_KEY=

# Hugging Face token (read access) for gated models like FLUX.2 klein: https://huggingface.co/settings/tokens
# Accept the licence at https://huggingface.co/black-forest-labs/FLUX.2-klein-9b-fp8 first.
HF_TOKEN=
